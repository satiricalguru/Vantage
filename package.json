{
  "name": "vantage",
  "version": "1.0.1",
  "description": "A free, native live wallpaper app for macOS",
  "main": "./out/main/index.js",
  "author": "Vantage Team",
  "homepage": "https://github.com/satiricalguru/Vantage",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build-icon.mjs && electron-vite dev",
    "build": "node scripts/build-icon.mjs && electron-vite build && npm run build:screen-saver",
    "build:icon": "node scripts/build-icon.mjs",
    "build:screen-saver": "node scripts/build-screen-saver.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "preview:ui": "vite --config vite.ui-preview.config.ts --mode ui-preview",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "electron": "^43.8.10",
    "electron-builder": "^25.1.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "com.vantage.app",
    "productName": "Vantage",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/screen-saver/Vantage.saver",
          "to": "Vantage.saver"
        }
      ],
      "artifactName": "Vantage-${version}-${arch}.${ext}"
    },
    "files": [
      "out/**/*",
      "resources/icons/**/*",
      "package.json",
      "!Extracted_Video_Wallpapers/**/*",
      "!resources/thumbnails/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/catalog.json",
        "to": "resources/catalog.json"
      },
      {
        "from": "resources/icons",
        "to": "resources/icons"
      },
      {
        "from": "resources/thumbnails",
        "to": "resources/thumbnails"
      },
      {
        "from": "resources/wallpapers",
        "to": "resources/wallpapers"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Vantage-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "satiricalguru",
      "repo": "Vantage",
      "releaseType": "draft"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@43.3.0": true,
    "koffi@2.16.3": true
  },
  "optionalDependencies": {
    "koffi": "^2.16.3"
  }
}
