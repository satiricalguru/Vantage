{
  "name": "vantage",
  "version": "1.0.0",
  "description": "A free, native live wallpaper app for macOS",
  "main": "./out/main/index.js",
  "author": "Vantage Team",
  "homepage": "https://github.com/satiricalguru/Vantage",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build-icon.mjs && electron-vite dev",
    "build": "node scripts/build-icon.mjs && electron-vite build && npm run build:screen-saver",
    "build:icon": "node scripts/build-icon.mjs",
    "build:screen-saver": "node scripts/build-screen-saver.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "com.vantage.app",
    "productName": "Vantage",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "out/**/*",
      "resources/icons/**/*",
      "package.json",
      "!Extracted_Video_Wallpapers/**/*",
      "!resources/thumbnails/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/catalog.json",
        "to": "resources/catalog.json"
      },
      {
        "from": "resources/thumbnails",
        "to": "resources/thumbnails"
      },
      {
        "from": "resources/wallpapers",
        "to": "resources/wallpapers"
      },
      {
        "from": "build/screen-saver/Vantage.saver",
        "to": "Vantage.saver"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
